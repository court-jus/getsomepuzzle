    "constraintExplainFM": "A pattern shown above the grid on a violet background must never appear inside the grid.",
    "@constraintExplainFM": {
        "description": "Body of the new-constraint explanation modal for the Forbidden Motif (FM) constraint"
    },
    "constraintExplainSH": "A pattern shown above the grid on a light blue background tilted at 45° defines an exact shape: every group of that color must take this shape (rotations and reflections allowed).",
    "@constraintExplainSH": {
        "description": "Body of the new-constraint explanation modal for the Shape (SH) constraint"
    },
    "constraintExplainGS": "A cell carrying a number must belong to a group of orthogonally adjacent same-color cells whose size matches that number.",
    "@constraintExplainGS": {
        "description": "Body of the new-constraint explanation modal for the Group Size (GS) constraint"
    },
    "constraintExplainPA": "A cell with an arrow demands the same number of black and white cells in front of the arrow. A double-headed arrow extends the rule to both sides.",
    "@constraintExplainPA": {
        "description": "Body of the new-constraint explanation modal for the Parity (PA) constraint"
    },
    "constraintExplainLT": "Cells marked with the same letter must belong to the same group. A group must not contain two different letters.",
    "@constraintExplainLT": {
        "description": "Body of the new-constraint explanation modal for the Letter Group (LT) constraint"
    },
    "constraintExplainMJ": "A dotted rectangle border in a specific color indicates that most cells inside the zone must be of that color (more than half). The border itself tells you which color must dominate.",
    "@constraintExplainMJ": {
        "description": "Body of the new-constraint explanation modal for the Majority (MJ) constraint"
    },
    "constraintExplainQA": "A number on a blue background above the grid sets the total number of cells of that color the solution must contain.",
    "@constraintExplainQA": {
        "description": "Body of the new-constraint explanation modal for the Quantity (QA) constraint"
    },
    "constraintExplainSY": "A cell carrying ⟍, |, ⟋, ― or 🞋 forces its group (same-color connected cells) to be symmetric along that axis. The 🞋 symbol means central symmetry — equivalent to a half-turn.",
    "@constraintExplainSY": {
        "description": "Body of the new-constraint explanation modal for the Symmetry (SY) constraint"
    },
    "constraintExplainDF": "Two cells separated by a ≠ symbol must be of different colors.",
    "@constraintExplainDF": {
        "description": "Body of the new-constraint explanation modal for the Different From (DF) constraint"
    },
    "constraintExplainLineCount": "A circled number beside a row or column tells how many cells of that color must appear in that line.",
    "@constraintExplainLineCount": {
        "description": "Body of the new-constraint explanation modal for the merged line count constraint (CC/RC)"
    },
    "constraintExplainLineMajority": "Colored concentric circles beside a row or column enforce a strict ordering of colors by count: the outermost color must have more cells than the next, and so on.",
    "@constraintExplainLineMajority": {
        "description": "Body of the new-constraint explanation modal for the line majority constraint (JC/JR)"
    },
    "constraintExplainTransition": "A square wave with a number beside a row or column tells how many color changes (transitions) must appear in that line. Each step of the wave is one change; a flat wave with 0 means the whole line is a single color.",
    "@constraintExplainTransition": {
        "description": "Body of the new-constraint explanation modal for the merged transition constraint (CT/RT)"
    },
    "constraintExplainGC": "A boxed number with a chain icon tells how many separate groups (connected components) of that color the solution must contain.",
    "constraintExplainBB": "Every connected group of this color must occupy a bounding box of exactly this width and height — the smallest rectangle enclosing the group spans exactly that many columns and rows (the group need not fill it).",
    "@constraintExplainGC": {
        "description": "Body of the new-constraint explanation modal for the Group Count (GC) constraint"
    },
    "constraintExplainNC": "A cell shown as a cross containing a number must have exactly that number of orthogonal neighbors of the marked color. The cross is filled with the target color and outlined in the opposite color so it stays readable on any background. For instance, a black cross holding the digit 2 means the cell must have exactly 2 black neighbors among its top/bottom/left/right cells.",
    "@constraintExplainNC": {
        "description": "Body of the new-constraint explanation modal for the Neighbor Count (NC) constraint"
    },
    "constraintExplainEY": "A cell with an eye must \"see\" exactly the indicated number of cells of the eye's color. Sight travels in a straight line in each of the four orthogonal directions until it hits the grid edge or a cell of the opposite color (which blocks the view). The eye's color is the target color; the border around the eye is the opposite color.",
    "@constraintExplainEY": {
        "description": "Body of the new-constraint explanation modal for the Eyes (EY) constraint"
    },
    "constraintExplainCH": "A mini-grid icon shows two sides of the grid connected by a chain. The solution must contain an unbroken orthogonal path of that color from the marked side to the other marked side. The path does not need to be a straight line — it can bend, branch, or widen, as long as there is at least one continuous connection between the two sides.",
    "@constraintExplainCH": {
        "description": "Body of the new-constraint explanation modal for the Chain (CH) constraint"
    },
    "constraintExplainIM": "An arrow from one cell to another means: if the source cell takes the arrow's colour, the target cell must also take that colour. The contrapositive also holds: if the target is a different colour, the source cannot take the arrow's colour.",
    "@constraintExplainIM": {
        "description": "Body of the new-constraint explanation modal for the Implication (IM) constraint"
    },
    "complicityOtherConstraint": "another constraint",
